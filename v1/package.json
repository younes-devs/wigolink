  "main": "index.js",
  "scripts": {
    "test": "node --test server/test/*.test.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev": "concurrently -n api,web -c yellow,cyan \"node server/index.js\" \"vite client --port 5173\"",
    "build": "vite build client",
    "start": "node server/index.js",
    "api": "node server/index.js",
    "migrate:plan": "node server/migrate-json-postgres-cli.js",
    "migrate:postgres": "node server/migrate-json-postgres-cli.js --write",
    "migrate:supabase": "node server/migrate-supabase-state-cli.js",
    "migrate:relational:plan": "node server/migrate-relational-state-cli.js",
    "migrate:relational": "node server/migrate-relational-state-cli.js --write",
    "migrate:relational:verify": "node server/verify-relational-state-cli.js",
    "migrate:message-media": "node server/migrate-message-media-cli.js",
    "migrate:locations": "node --env-file-if-exists=.env.local scripts/migrate-smart-location-search.mjs",
    "migrate:locations:write": "node --env-file-if-exists=.env.local scripts/migrate-smart-location-search.mjs --write",
    "load:test": "node scripts/load-test.mjs",
    "audit:production": "node scripts/audit-production.mjs"
  },
