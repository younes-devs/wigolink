# =============================================================================
# Wigofly — variables d'environnement (exemple)
# =============================================================================
# Copier en `.env` et adapter. Ne JAMAIS committer un vrai `.env` (voir .gitignore).
# En dev, l'API lit process.env directement. Node 20+ peut charger ce fichier avec :
#   node --env-file=.env server/index.js
# =============================================================================

# --- Serveur ---------------------------------------------------------------
# Port d'écoute de l'API Express.
PORT=4517

# --- Mode démo (NE JAMAIS activer en production) ---------------------------
# DEMO=true expose /api/dev/* (bascule de compte sans mot de passe) et renvoie les
# codes de vérification en clair dans les réponses API. Réservé au dev/démo local.
# En production : laisser vide / false, un vrai prestataire email/SMS envoie les codes.
DEMO=false

# --- Persistance -----------------------------------------------------------
# V1 démo : persistance fichier JSON. `DATA_FILE` surcharge le chemin (utilisé par les
# tests pour isoler leur base). Laisser vide pour server/data.json par défaut.
DATA_FILE=

# Cible production (PRD P0.1) : Postgres Supabase. Une fois l'adaptateur de persistance
# branché, `DATABASE_URL` remplace le fichier JSON. Voir docs/supabase-schema.sql.
# DATABASE_URL=postgresql://user:password@host:5432/wigofly

# Driver de persistance. Par defaut: `json` si DATABASE_URL est vide, `postgres`
# si DATABASE_URL est defini. Le mode Postgres complet reste bloque tant que toutes
# les collections critiques ne sont pas migrees.
PERSISTENCE_DRIVER=json

# Migration partielle explicite (dev/staging seulement): permet de brancher une
# premiere collection sur Postgres tout en gardant les autres en JSON.
# PERSISTENCE_ALLOW_PARTIAL=true
# PERSISTENCE_POSTGRES_COLLECTIONS=auditLogs,notifications

# --- Emails transactionnels (PRD P0.2 / P1.7) ------------------------------
# Prestataire d'envoi (Resend recommandé) : vérification email, reset mot de passe,
# notifications critiques. Sans clé, aucun email n'est réellement envoyé.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=no-reply@wigofly.app

# URL publique de l'app (liens dans les emails : vérification, reset, notifications).
# APP_URL=https://app.wigofly.app

# --- Paiement / escrow (PRD P0.4) ------------------------------------------
# Prestataire détenant les fonds. 'simulated' = aucun mouvement réel (V1). À basculer
# vers 'stripe' | 'mangopay' | 'lemonway' une fois l'intégration prête. Le domaine porte
# déjà les champs provider (transactions.payment_provider / payment_intent_id).
PAYMENT_PROVIDER=simulated
