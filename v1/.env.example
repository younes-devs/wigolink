# Vercel: le frontend et les routes API sont servis sous le meme domaine.
# Laisser VITE_API_BASE_URL vide pour utiliser /api automatiquement.
# VITE_API_BASE_URL=https://votredomaine.com/api

# Fonctions API Vercel
NODE_ENV=production
APP_ORIGIN=https://votredomaine.com
APP_URL=https://votredomaine.com
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Wigofly <noreply@votredomaine.com>

# Ne jamais activer en production.
DEMO=false

# La persistance JSON est exclusivement locale. Ne pas deployer en production tant que
# le connecteur Postgres complet n'est pas active pour toutes les collections.
PERSISTENCE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
