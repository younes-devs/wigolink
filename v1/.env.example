# Vercel: le frontend et les routes API sont servis sous le meme domaine.
# Laisser VITE_API_BASE_URL vide pour utiliser /api automatiquement.
# VITE_API_BASE_URL=https://votredomaine.com/api

# Fonctions API Vercel
NODE_ENV=production
APP_ORIGIN=https://votredomaine.com
APP_URL=https://votredomaine.com
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Wigofly <noreply@votredomaine.com>

# Ne jamais activer en production.
DEMO=false


# En production, ces collections deviennent relationnelles : sessions, messages,
# notifications et journal d'audit. Cette URL est une cle serveur: ne jamais
# l'exposer au navigateur.
PERSISTENCE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DB_POOL_MAX=5
# Mettre a jour lors d'un changement de plan Supabase (Free: 500 MiB,
# Pro inclus: 8 GiB). Ces valeurs alimentent les alertes de capacite.
DB_CAPACITY_BYTES=524288000
DB_CONNECTION_BUDGET=60
DB_CAPACITY_WARNING_RATIO=0.70
DB_CAPACITY_CRITICAL_RATIO=0.85
DB_DEAD_ROW_WARNING_RATIO=0.20

# Activer uniquement apres l'execution et la verification de la migration
# relationnelle decrite dans docs/DEPLOYMENT.md.
RELATIONAL_TRIP_READS=false
RELATIONAL_MESSAGE_READS=false
# Active les ecritures de messages ligne par ligne apres migration du schema.
RELATIONAL_MESSAGE_WRITES=false
RELATIONAL_CONVERSATION_MEMBERS=false
RELATIONAL_OPERATION_READS=false
RELATIONAL_TRIP_WRITES=false
RELATIONAL_OPERATION_WRITES=false
RELATIONAL_AUTH=false
RELATIONAL_KYC=false
RELATIONAL_ADMIN_MEMBERS=false
RELATIONAL_ADMIN_ACTIONS=false
RELATIONAL_SAFETY_APPEALS=false
LAZY_GLOBAL_STATE=false
CRON_SECRET=
RELATIONAL_TRIP_MUTATIONS=false

# Supabase Realtime: URL et cle publishable sont transmises seulement aux comptes connectes.
# La cle secret reste exclusivement sur Vercel pour diffuser les mises a jour.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Bucket prive cree automatiquement au premier envoi d'image.
SUPABASE_MESSAGE_MEDIA_BUCKET=wigofly-message-media
SUPABASE_KYC_MEDIA_BUCKET=wigofly-kyc-media
SUPABASE_PROFILE_MEDIA_BUCKET=wigofly-profile-media

# Observabilite serveur. Les erreurs et requetes lentes sont journalisees en JSON
# dans Vercel Logs. Activer le journal complet seulement pendant un diagnostic.
SLOW_REQUEST_MS=1000
OBSERVABILITY_LOG_ALL=false
